@PACKAGE_INIT@

find_package(CUDAToolkit REQUIRED)
if(NOT TARGET PORTABLE::PORTABLE)
  include("${CMAKE_CURRENT_LIST_DIR}/../PORTABLE/PORTABLETargets.cmake")
endif()
if(NOT TARGET PHF::phf_cu)
  include("${CMAKE_CURRENT_LIST_DIR}/../PHF/HFTargets.cmake")
endif()
if(NOT TARGET FZG::fzg_cu)
  include("${CMAKE_CURRENT_LIST_DIR}/../FZG/FZGTargets.cmake")
endif()
if(NOT TARGET UTILS::utils_headers)
  include("${CMAKE_CURRENT_LIST_DIR}/../EVAL/EVALTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CUSZTargets.cmake")

check_required_components(cusz)
